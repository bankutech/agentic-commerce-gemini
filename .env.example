RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# SQLite file backing carts, orders, campaign usage counts, and stock.
# Defaults to ./agentic_commerce.db if unset.
DATABASE_PATH=agentic_commerce.db

# Optional: enables Gemini-backed recommendation ranking (app/recommendations/ai_ranker.py)
# and the LangGraph buyer agent (agent/langgraph_agent.py). Without this, the
# recommendation engine still works — it just falls back to rule-based ranking only.
GOOGLE_API_KEY=REPLACE_ME
